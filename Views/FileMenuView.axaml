<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:viewModels="clr-namespace:Notepad_V2.ViewModels"
             x:DataType="viewModels:FileMenuViewModel"
             x:Class="Notepad_V2.Views.FileMenuView">
    
    <UserControl.Styles>
        <Style Selector="MenuItem">
            <Setter Property="Focusable" Value="False"/>
        </Style>
    </UserControl.Styles>
 <Grid>

     
     
    <Menu Grid.Column="0"
          Grid.Row="0"
          HorizontalAlignment="Left"
          VerticalAlignment="Top">
      
        <!-- File Menu -->
        <MenuItem Header="File"
                  x:Name="Filemenu">

            <MenuItem Header="New"
                  
                      x:Name="NewFilemenu" 
                       Command="{Binding  NewFileCommand}" />

            <MenuItem Header="New Window"
                      x:Name="NewWindowMenu" 
                       Command="{Binding NewWindowCommand}" />

            <MenuItem Header="Open..."
                  
                      x:Name="OpenMenu"
                      Command="{Binding OpenFileCommand}" />

            <MenuItem Header="Save"
                      x:Name="SaveMenu"
                      Command="{Binding SaveFileCommand}" />

            <MenuItem Header="Save As..."
                      x:Name="SaveasMenu" 
                      Command="{Binding SaveFileasCommand}"/>

            <MenuItem Header="Print"
                   
                      x:Name="PrintMenu"
                      Command="{Binding PrintCommand}"/>

            <Separator />

            <MenuItem Header="Exit"
                   
                      x:Name="ExitMenu"
                      Command="{Binding ExitCommand}"/>
        </MenuItem>

        <!-- Edit Menu -->
        <MenuItem Header="_Edit"
                  x:Name="EditMenu">

            <MenuItem Header="Undo"
                      x:Name="UndoMenu"
                    
                      Command="{Binding UndoCommand}"/>

            <MenuItem Header="Cut"
                     
                      x:Name="CutMenu"
                      Command="{Binding CutCommand}"/>

            <MenuItem Header="Copy"
                      x:Name="CopyMenu"
                      Command="{Binding CopyCommand}"/>

            <MenuItem Header="Paste"
                      x:Name="PasteMenu"
                      Command="{Binding PasteCommand}"/>

            <MenuItem Header="Delete" 
                      x:Name="DeleteMenu"
                      Command="{Binding DeleteCommand}"/>

            <Separator />

            <MenuItem Header="Find..."
                      x:Name="FindMenu" 
                      Command="{Binding FindCommand}"
                      />

            <MenuItem Header="Find Next"
                      x:Name="FindNextMenu" 
                      Command="{Binding FindNextCommand}"/>

            <MenuItem Header="Replace..."
                      x:Name="ReplaceMenu" 
                      Command="{Binding ReplaceCommand}"/>

            <MenuItem Header="Go To..."
                      x:Name="GoTomenuitem"
                      Command="{Binding GoToCommand}"/>

            <Separator />

            <MenuItem Header="Select All"
                      x:Name="SelectAllmenuitem"
                      Command="{Binding SelectAllCommand}"
                      />

            <MenuItem Header="Time/Date"
                      x:Name="TimeDateMenuItem" 
                      Command="{Binding TimeDateCommand}"/>
        </MenuItem>
        
        
        
        

        <!-- Format Menu -->
        <MenuItem Header="_Format"
                  x:Name="FormatMenuitem">

            <MenuItem Header="Word Wrap"
                      x:Name="WordWrapMenuItem" 
                      Command="{Binding WordWrapCommand}"/>

            <MenuItem Header="Font..."
                      x:Name="FontMenuItem"
                      Command="{Binding FontCommand}"/>

            <Separator />

            <MenuItem Header="Bulletin list"
                      x:Name="BulletinListMenuItem" 
                      Command="{Binding BulletinListCommand}"/>

            <MenuItem Header="Numbered list"
                      x:Name="NumberedListMenuItem"
                      Command="{Binding NumberedListCommand}"/>
        </MenuItem>

        <!-- View Menu -->
        <MenuItem Header="_View"
                  x:Name="ViewMenuItem">

            <MenuItem Header="View Help"
                      x:Name="ViewHelpMenuItem"
                      Command="{Binding ViewHelpCommand}"/>

            <MenuItem Header="About Notepad_V2"
                      x:Name="AboutMenuItem"
                      Command="{Binding AboutNotepadV2Command}"
                      />

            <MenuItem Header="Leave a Review"
                      x:Name="ReviewMenuItem"
                      Command="{Binding LeaveAReviewCommand}"/>
        </MenuItem>

    </Menu>

    <!-- Grid Layout -->
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Editor -->
    <TextBox x:Name="ContentTextBox"
             Text="{Binding Path= Content}"
             Grid.Column="1"
             Grid.Row="1"
             Margin="1,1,1,0"
             HorizontalAlignment="Center"
             VerticalAlignment="Center"
             Width="736"
             Height="388"
             BorderThickness="1"
             AcceptsReturn="True"
             Focusable="True"
             IsInactiveSelectionHighlightEnabled="True"
             />

</Grid>   
   
</UserControl>
