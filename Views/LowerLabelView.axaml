<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Notepad_V2.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:LowerLabelViewModel"
             x:Class="Notepad_V2.Views.LowerLabelView">
    
       <Grid>
   <Grid.ColumnDefinitions>


          <ColumnDefinition />
          <ColumnDefinition />
   </Grid.ColumnDefinitions>    
   <Grid.RowDefinitions>
       
          
       
       
   </Grid.RowDefinitions>   
    <Label Grid.Column="0" 
           Content="{Binding FileModel.Filepath}"
           x:Name="UpdateColRowLabel"
           HorizontalAlignment="Left" 
           HorizontalContentAlignment="Left"
           VerticalAlignment="Bottom"
           Margin="10,0,0,10"><!--Content="{Binding Labels.col_row}"-->

    </Label>
       
       
       <Label Grid.Column="0" 
              
              x:Name="FilePathLabel"
             Background="Red"
              
              HorizontalAlignment="Center" 
              HorizontalContentAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="340,110,0,10">

       </Label>
           
       <Label Grid.Column="1" 
              
              x:Name="FileNameLabel"
              Content="{Binding FileModel.Filename }"
             HorizontalAlignment="Center" 
              VerticalAlignment="Bottom"
              Margin="0,10,0,0"
           
              ><!--  Content="{Binding File.Filename}"" -->

       </Label>
       
   </Grid>
    
    
</UserControl>
