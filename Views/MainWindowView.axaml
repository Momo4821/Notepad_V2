<Window
    x:Class="Notepad_V2.MainWindowView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:notepadV2="clr-namespace:Notepad_V2"
    xmlns:views="clr-namespace:Notepad_V2.Views"
    Title="Notepad_V2"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:CompileBindings="True"
   x:DataType="notepadV2:MainWindowView">
 

<Grid>
<Grid.ColumnDefinitions>
   <ColumnDefinition/>
   <ColumnDefinition/>
</Grid.ColumnDefinitions>
 
    <DockPanel
        Dock="Top">
        
    </DockPanel>
    
    <views:FileMenuView Grid.Row="0" Grid.Column="0"/>
    <views:TextBoxView Grid.Row="0" Grid.Column="1"/>
    <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
    </Grid.RowDefinitions>
    
</Grid>


 

   

   

        
        
       
        
  
</Window>