<Window
    x:Class="Notepad_V2.MainWindowView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:notepadV2="clr-namespace:Notepad_V2"
    xmlns:views="clr-namespace:Notepad_V2.Views"
    xmlns:viewModels="clr-namespace:Notepad_V2.ViewModels"
    Title="Notepad_V2"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:CompileBindings="True"
   x:DataType="viewModels:MainWindowViewModel">
 

<Grid>
<Grid.ColumnDefinitions>

</Grid.ColumnDefinitions>
    
    <Grid.RowDefinitions>
     
    </Grid.RowDefinitions>
    
    <views:FileMenuView x:Name="FileMenuView" Grid.Row="0" Grid.Column="0"/>
 
    <views:LowerLabelView x:Name="LowerLabelView" Grid.Row="2" Grid.Column="0"></views:LowerLabelView>
    
</Grid>
    
   <!--View → binds to → ViewModel

ViewModel → exposes → Model properties

Model → contains → data=-->
</Window>